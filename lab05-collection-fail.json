						"body": {"mode": "raw", "raw": "{\"status\": \"active\", \"coursesTaken\": []}"},
						"url": {"raw": "{{baseUrl}}/students/B231234569", "host": ["{{baseUrl}}"], "path": ["students", "B231234569"]}
