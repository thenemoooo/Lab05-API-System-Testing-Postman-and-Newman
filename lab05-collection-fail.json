		{
			"name": "Task 5: Public API - JSONPlaceholder",
			"item": [
				{
					"name": "GET Public Users",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
									"pm.test('Response is array', function () { var data = pm.response.json(); pm.expect(data).to.be.an('array'); });",
									"pm.test('First user is Leanne Graham', function () { var data = pm.response.json(); pm.expect(data[0].name).to.eql('Leanne Graham'); });"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {"raw": "https://jsonplaceholder.typicode.com/users", "protocol": "https", "host": ["jsonplaceholder", "typicode", "com"], "path": ["users"]}
					}
				}
			]
